{
  "id": "llle0x.qinglong",
  "name": "青龙同步配置",
  "description": "Surge Cookie 同步到自己的青龙",
  "author": "llle0x",
  "repo": "https://github.com/llle0x/qinglong",
  "apps": [
    {
      "id": "llle0x.qinglong.sync",
      "name": "通用凭证 → 青龙",
      "desc": "爱奇艺、阿里云、九号出行及自定义网站共用一个同步模块。新凭证留空时沿用之前的爱奇艺/阿里云青龙配置。",
      "keys": [
        "qinglong_sync_url",
        "qinglong_sync_client_id",
        "qinglong_sync_client_secret",
        "qinglong_sync_rules",
        "CookieQY",
        "aliyunWeb_data",
        "Ninebot.Accounts.SurgeV2"
      ],
      "settings": [
        {
          "id": "qinglong_sync_url",
          "name": "青龙面板根地址",
          "val": "",
          "type": "text",
          "desc": "留空沿用原配置；填写时不要加 /open。"
        },
        {
          "id": "qinglong_sync_client_id",
          "name": "Client ID",
          "val": "",
          "type": "text",
          "desc": "留空沿用原配置。"
        },
        {
          "id": "qinglong_sync_client_secret",
          "name": "Client Secret",
          "val": "",
          "type": "text",
          "desc": "留空沿用原配置；凭证仅本地保存，不要公开备份。"
        },
        {
          "id": "qinglong_sync_rules",
          "name": "自定义同步规则（JSON 数组）",
          "val": "[]",
          "type": "text",
          "desc": "默认已支持爱奇艺和阿里云，无需修改。添加其他网站参见仓库 README。"
        }
      ]
    },
    {
      "id": "llle0x.qinglong.iqiyi",
      "name": "爱奇艺 → 青龙",
      "desc": "单账号同步。凭证只在手机本地填写，不要上传配置备份。",
      "keys": [
        "qinglong_iqiyi_url",
        "qinglong_iqiyi_client_id",
        "qinglong_iqiyi_client_secret",
        "CookieQY"
      ],
      "settings": [
        {
          "id": "qinglong_iqiyi_url",
          "name": "青龙面板根地址",
          "val": "",
          "type": "text",
          "desc": "例如 https://ql.example.com 或内网 http://192.168.1.100:5700；不要加 /open"
        },
        {
          "id": "qinglong_iqiyi_client_id",
          "name": "Client ID",
          "val": "",
          "type": "text"
        },
        {
          "id": "qinglong_iqiyi_client_secret",
          "name": "Client Secret",
          "val": "",
          "type": "text"
        }
      ]
    },
    {
      "id": "llle0x.qinglong.aliyun",
      "name": "阿里云 → 青龙",
      "desc": "与爱奇艺共用青龙凭证。捕获后合并账号 Cookie，不自动运行任务。",
      "keys": [
        "qinglong_iqiyi_url",
        "qinglong_iqiyi_client_id",
        "qinglong_iqiyi_client_secret",
        "aliyunWeb_data"
      ],
      "settings": [
        {
          "id": "qinglong_iqiyi_url",
          "name": "青龙面板根地址",
          "val": "",
          "type": "text",
          "desc": "例如 https://ql.example.com 或内网 http://192.168.1.100:5700；不要加 /open"
        },
        {
          "id": "qinglong_iqiyi_client_id",
          "name": "Client ID",
          "val": "",
          "type": "text"
        },
        {
          "id": "qinglong_iqiyi_client_secret",
          "name": "Client Secret",
          "val": "",
          "type": "text"
        }
      ]
    },
    {
      "id": "llle0x.qinglong.ninebot",
      "name": "九号出行 → 青龙",
      "desc": "通用同步模块自动捕获九号 Token 与设备 ID，同步到 NINEBOT_ACCOUNTS。可手动运行通用脚本同步本地已有数据。凭证仅在手机本地填写，勿公开分享。",
      "keys": ["Ninebot.Accounts.SurgeV2", "Ninebot.Accounts"]
    }
  ]
}
