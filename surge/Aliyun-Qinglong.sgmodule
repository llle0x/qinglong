#!name=阿里云社区 Cookie 同步青龙
#!desc=打开阿里云 App 积分商城捕获 Cookie，共用 BoxJS 青龙凭证，合并账号后同步 aliyunWeb_data。

[Script]
阿里云Cookie同步 = type=http-response,pattern=^https:\/\/developer\.aliyun\.com\/developer\/api\/my\/user\/getUser(?:[/?]|$),requires-body=true,timeout=60,script-path=https://raw.githubusercontent.com/llle0x/qinglong/main/surge/aliyun-sync.js

[MITM]
hostname = %APPEND% developer.aliyun.com
