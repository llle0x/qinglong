#!name=通用青龙凭证同步
#!desc=一个模块同步爱奇艺、阿里云和自定义凭证。更新 BoxJS 青龙订阅后配置。仅同步变量，不自动运行任务。
#!arguments=捕获匹配:^https:\/\/(?:passport\.iqiyi\.com\/apis\/user\/|developer\.aliyun\.com\/developer\/api\/my\/user\/getUser(?:[/?]|$))
#!arguments-desc=新网站需扩展捕获匹配、在 Surge MITM 中加入网站域名，并在 BoxJS 自定义规则中添加变量映射。保持捕获范围精确，避免与其他重写脚本冲突。

[Script]
通用青龙同步 = type=http-response,pattern={{{捕获匹配}}},requires-body=true,timeout=60,script-path=https://raw.githubusercontent.com/llle0x/qinglong/main/surge/qinglong-sync.js

[MITM]
hostname = %APPEND% passport.iqiyi.com, developer.aliyun.com
